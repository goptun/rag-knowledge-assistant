# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base

# Embeddings / Reranker (rodam localmente, sem API key)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Índice sparse (BM25), gerado pelo run_indexing.py
BM25_INDEX_PATH=data/bm25_index.pkl

# LLM (Fase 5 — geração da resposta)
# "anthropic"       -> API oficial da Anthropic, precisa de ANTHROPIC_API_KEY com crédito
# "openai_compatible" -> proxy local (ex.: 9Router) via LLM_BASE_URL/LLM_API_KEY
LLM_PROVIDER=openai_compatible
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Só usados quando LLM_PROVIDER=openai_compatible (9Router local)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=

# Geração (Fase 5) — troque LLM_MODEL pro id exato exposto pelo seu combo
# do 9Router (ver aba "Combo & Vision Adapter" no dashboard dele) ou, se
# LLM_PROVIDER=anthropic, por um id válido em
# https://docs.claude.com/en/docs/about-claude/models
LLM_MODEL=claude-sonnet-4-5-20250929
GENERATION_MAX_TOKENS=1024
GENERATION_TEMPERATURE=0.0
